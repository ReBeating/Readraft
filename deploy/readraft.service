[Unit]
Description=Readraft FastAPI service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=readraft
Group=readraft
UMask=0077
WorkingDirectory=/opt/readraft
EnvironmentFile=/opt/readraft/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/readraft/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8010 --workers 1
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/readraft/data
MemoryHigh=450M
MemoryMax=600M

[Install]
WantedBy=multi-user.target
