APP_NAME=Readraft
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-long-random-string
# 可选；设置后用于加密用户 API Key。留空时复用 APP_SECRET_KEY。
APP_CREDENTIAL_ENCRYPTION_KEY=
APP_DATA_DIR=./data
APP_DATABASE_PATH=./data/readraft.db
APP_COOKIE_SECURE=false
APP_ALLOW_REGISTRATION=true
APP_MAX_UPLOAD_BYTES=20971520
APP_MAX_TEXT_CHARS=4000000
APP_TARGET_CHAPTER_CHARS=12000
APP_MAX_CHAPTER_CHARS=30000
APP_MAX_DOCUMENTS_PER_USER=50
APP_MAX_STORED_CHARS_PER_USER=20000000
APP_MAX_WORK_ARCHIVE_BYTES=268435456
# 开发环境自动允许；生产环境若需 Ollama/内网网关必须显式改为 true。
APP_ALLOW_PRIVATE_MODEL_BASE_URLS=false

# 可留空并由用户在网页中配置个人 Key；不会回退生成模拟内容。
MODEL_PROVIDER=deepseek
MODEL_API_KEY=
# 官方供应商忽略 MODEL_BASE_URL；仅自定义 OpenAI 和 Ollama 需要填写。
MODEL_BASE_URL=
MODEL_NAME=deepseek-v4-flash
# 可选的服务器级模型适配策略；个人网页设置会优先使用账号自己的值。
MODEL_ADAPTER_PROMPT=
MODEL_MAX_TOKENS=5000
MODEL_CONNECT_TIMEOUT_SECONDS=10
MODEL_READ_TIMEOUT_SECONDS=300
MODEL_MAX_RETRIES=3

# 联网搜索默认使用 Exa 的免认证 MCP 服务。访问量增大后可选填，
# 由服务器统一扩充额度，普通用户无需配置。
EXA_API_KEY=
